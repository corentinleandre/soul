{
  "name": "soul",
  "version": "1.0.0",
  "description": "Universal Tabletop System",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:code && npm run build:css",
    "build:code": "rollup -c",
    "build:css": "lessc less/soul.less soul.css",
    "createSymlinks": "node ./tools/create-symlinks.mjs",
    "postinstall": "npm run createSymlinks",
    "lint": "eslint soul.mjs src/module/**/* templates/**/*",
    "lint:fix": "eslint --fix soul.mjs src/module/**/* templates/**/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetaMorphic-Digital/soul.git"
  },
  "keywords": [
    "fvtt",
    "system"
  ],
  "author": "MetaMorphic Digital",
  "bugs": {
    "url": "https://github.com/MetaMorphic-Digital/soul/issues"
  },
  "homepage": "https://github.com/MetaMorphic-Digital/soul#readme",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@html-eslint/eslint-plugin": "^0.26.0",
    "@html-eslint/parser": "^0.26.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@stylistic/eslint-plugin": "^5.5.0",
    "eslint": "^9.27.0",
    "eslint-plugin-jsdoc": "^51.4.1",
    "less": "^4.9.1",
    "rollup": "^4.9.1",
    "less-watch-compiler": "^1.19.9"
  }
}
