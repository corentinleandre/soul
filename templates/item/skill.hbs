<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="characteristics">
  <div class="flexrow">
    <div class="flexcol">
      <div class="label-brown">{{localize 'SOUL.Skills.description'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.level'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.maxLevel'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.maxMod'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.stat'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.modifier'}}</div>
    </div>
    <div class="flexcol">
      <div class="label-black">{{formInput systemFields.description value=system.description}}</div>
      <div class="label-black">{{formInput systemFields.level value=system.level}}</div>
      <div class="label-black">{{formInput systemFields.maxLevel value=system.maxLevel}}</div>
      <div class="label-black">{{formInput systemFields.maxMod value=system.maxMod}}</div>
      <div class="label-black">{{formInput systemFields.stat value=system.stat}}</div>
      <div class="label-black">{{formInput systemFields.modifier value=system.modifier}}</div>
    </div>
  </div>
</section>