<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="characteristics">
  <div class="flexrow">
    <div class="flexcol">
      <div class="label-brown">{{localize 'SOUL.Skills.description'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.level'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.maxLevel'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.maxMod'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.stat'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.modifier'}}</div>
    </div>
    <div class="flexcol">
      <div class="label-black">{{formInput itemFields.description value=item.description}}</div>
      <div class="label-black">{{formInput itemFields.level value=item.level}}</div>
      <div class="label-black">{{formInput itemFields.maxLevel value=item.maxLevel}}</div>
      <div class="label-black">{{formInput itemFields.maxMod value=item.maxMod}}</div>
      <div class="label-black">{{formInput itemFields.stat value=item.stat}}</div>
      <div class="label-black">{{formInput itemFields.modifier value=item.modifier}}</div>
    </div>
  </div>
</section>