<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="characteristics">
    <div class="skills grid grid-2col">
    <div class="label-brown">{{localize 'SOUL.Skills.description'}}</div>
    <div class="">{{formInput systemFields.description value=system.description}}</div>

    <div class="label-brown">{{localize 'SOUL.Skills.level'}}</div>
    <div class="">{{formInput systemFields.level value=system.level}}</div>

    <div class="label-brown">{{localize 'SOUL.Skills.maxLevel'}}</div>
    <div class="">{{formInput systemFields.maxLevel value=system.maxLevel}}</div>

    <div class="label-brown">{{localize 'SOUL.Skills.maxMod'}}</div>
    <div class="">{{formInput systemFields.maxMod value=system.maxMod}}</div>

    <div class="label-brown">{{localize 'SOUL.Skills.stat'}}</div>
    <div class="">{{formInput systemFields.stat value=system.stat}}</div>

    <div class="label-brown">{{localize 'SOUL.Skills.modifier'}}</div>
    <div class="">{{formInput systemFields.modifier value=system.modifier}}</div>
  </div>
</section>