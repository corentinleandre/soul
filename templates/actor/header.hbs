<header class="sheet-header flexcol">
  <div class="flexrow">
    <img
    class="profile-img"
    src="{{actor.img}}"
    alt="{{actor.name}}"
    {{#if editable}}
    data-action="editImage"
    data-edit="img"
    {{/if}}
    data-tooltip="{{actor.name}}"
    height="100" width="100"
    >
    {{formInput actorFields.name value=actor.name}}
  </div>
  <div class="flexrow">
    <div class="stats grid grid-3row grid-flow-horizontal grid-align-center">
      <!-- labels -->
      <div> </div>
      <div class="label-black">Base</div>
      <div class="label-black">Bonus</div>

      <!-- stats -->
      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.strength'}}</div>
      <div class="soul-tile">{{system.strength.value}}</div>
      <div class="soul-tile">{{system.strength.bonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.dexterity'}}</div>
      <div class="soul-tile">{{system.dexterity.value}}</div>
      <div class="soul-tile">{{system.dexterity.bonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.senses'}}</div>
      <div class="soul-tile">{{system.senses.value}}</div>
      <div class="soul-tile">{{system.senses.bonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.endurance'}}</div>
      <div class="soul-tile">{{system.endurance.value}}</div>
      <div class="soul-tile">{{system.endurance.bonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.agility'}}</div>
      <div class="soul-tile">{{system.agility.value}}</div>
      <div class="soul-tile">{{system.agility.bonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.intelligence'}}</div>
      <div class="soul-tile">{{system.intelligence.value}}</div>
      <div class="soul-tile">{{system.intelligence.bonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.resilience'}}</div>
      <div class="soul-tile">{{system.resilience.value}}</div>
      <div class="soul-tile">{{system.resilience.bonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.social'}}</div>
      <div class="soul-tile">{{system.social.value}}</div>
      <div class="soul-tile">{{system.social.bonus}}</div>
    </div>
  </div>
</header>