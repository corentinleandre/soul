<header class="sheet-header flexcol">
  <div class="flexrow">
    <img
    class="profile-img"
    src="{{actor.img}}"
    alt="{{actor.name}}"
    {{#if editable}}
    data-action="editImage"
    data-edit="img"
    {{/if}}
    data-tooltip="{{actor.name}}"
    height="100" width="100"
    >
    {{formInput actorFields.name value=actor.name}}
  </div>
  <div class="flexrow">
    <div class="stats grid grid-3row grid-flow-horizontal grid-align-center">
      <!-- labels -->
      <div> </div>
      <div class="label-black">{{localize 'SOUL.Stats.base'}}</div>
      <div class="label-black">{{localize 'SOUL.Stats.bonus'}}</div>

      {{#each stats as |stat name|}}
      <!-- stats auto -->
      <div class="label-brown">{{localize stat.shorthand}}</div>
      <div class="soul-tile">{{stat.value}}</div>
      <div class="soul-tile">{{stat.bonus}}</div>
      {{/each}}

      <!-- old stats
      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.dexterity'}}</div>
      <div class="soul-tile">{{system.dexterity.value}}</div>
      <div class="soul-tile">{{system.dexterity.bonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.senses'}}</div>
