<header class="sheet-header flexcol">
  <div class="flexrow">
    <img
    class="profile-img"
    src="{{actor.img}}"
    alt="{{actor.name}}"
    {{#if editable}}
    data-action="editImage"
    data-edit="img"
    {{/if}}
    data-tooltip="{{actor.name}}"
    height="100" width="100"
    >
    {{formInput actorFields.name value=actor.name}}
  </div>
  <div class="flexrow">
    <div class="stats grid grid-3row grid-flow-horizontal">
      <!-- labels -->
      <div> </div>
      <div class="label">Base</div>
      <div class="label">Bonus</div>

      <!-- stats -->
      <div class="title">Str</div>
      <div>{{formGroup systemFields.strength value=system.strength localize=true}}</div>
      <div>{{system.strengthBonus}}</div>

      <div class="title">Dex</div>
      <div>{{formGroup systemFields.dexterity value=system.dexterity localize=true}}</div>
      <div>{{system.dexterityBonus}}</div>

      <div class="title">Sen</div>
      <div>{{formGroup systemFields.senses value=system.senses localize=true}}</div>
      <div>{{system.sensesBonus}}</div>

      <div class="title">End</div>
      <div>{{formGroup systemFields.endurance value=system.endurance localize=true}}</div>
      <div>{{system.enduranceBonus}}</div>

    </div>
  </div>
</header>
