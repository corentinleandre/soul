<header class="sheet-header flexcol">
  <div class="flexrow">
    <img
    class="profile-img"
    src="{{actor.img}}"
    alt="{{actor.name}}"
    {{#if editable}}
    data-action="editImage"
    data-edit="img"
    {{/if}}
    data-tooltip="{{actor.name}}"
    height="100" width="100"
    >
    {{formInput actorFields.name value=actor.name}}
  </div>
  <div class="flexrow">
    <div class="stats grid grid-3row grid-flow-horizontal grid-align-center">
      <!-- labels -->
      <div> </div>
      <div class="label-black">Base</div>
      <div class="label-black">Bonus</div>

      <!-- stats -->
      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.strength'}}</div>
      <div>{{formInput systemFields.strength value=system.strength}}</div>
      <div class="soul-tile">{{system.strengthBonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.dexterity'}}</div>
      <div>{{formInput systemFields.dexterity value=system.dexterity}}</div>
      <div class="soul-tile">{{system.dexterityBonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.senses'}}</div>
      <div>{{formInput systemFields.senses value=system.senses}}</div>
      <div class="soul-tile">{{system.sensesBonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.endurance'}}</div>
      <div>{{formInput systemFields.endurance value=system.endurance}}</div>
      <div class="soul-tile">{{system.enduranceBonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.agility'}}</div>
      <div>{{formInput systemFields.agility value=system.agility}}</div>
      <div class="soul-tile">{{system.agilityBonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.intelligence'}}</div>
      <div>{{formInput systemFields.intelligence value=system.intelligence}}</div>
      <div class="soul-tile">{{system.intelligenceBonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.resilience'}}</div>
      <div>{{formInput systemFields.resilience value=system.resilience}}</div>
      <div class="soul-tile">{{system.resilienceBonus}}</div>

      <div class="label-brown">{{localize 'SOUL.Stats.Shorthands.social'}}</div>
      <div>{{formInput systemFields.social value=system.social}}</div>
      <div class="soul-tile">{{system.socialBonus}}</div>
    </div>
  </div>
</header>
