<header class="sheet-header flexcol">
  <div class="flexrow">
    <img
    class="profile-img"
    src="{{actor.img}}"
    alt="{{actor.name}}"
    {{#if editable}}
    data-action="editImage"
    data-edit="img"
    {{/if}}
    data-tooltip="{{actor.name}}"
    height="100" width="100"
    >
    {{formInput actorFields.name value=actor.name}}
  </div>
  <div class="flexrow">
    <div class="stats grid grid-3row grid-flow-horizontal grid-align-center">
      <!-- labels -->
      <div> </div>
      <div class="label-black">Base</div>
      <div class="label-black">Bonus</div>

      <!-- stats -->
      <div class="label-brown">Str</div>
      <div>{{formInput systemFields.strength value=system.strength localize=true}}</div>
      <div>{{system.strengthBonus}}</div>

      <div class="label-brown">Dex</div>
      <div>{{formInput systemFields.dexterity value=system.dexterity localize=true}}</div>
      <div>{{system.dexterityBonus}}</div>

      <div class="label-brown">Sen</div>
      <div>{{formInput systemFields.senses value=system.senses localize=true}}</div>
      <div>{{system.sensesBonus}}</div>

      <div class="label-brown">End</div>
      <div>{{formInput systemFields.endurance value=system.endurance localize=true}}</div>
      <div>{{system.enduranceBonus}}</div>

      <div class="label-brown">Agi</div>
      <div>{{formInput systemFields.agility value=system.agility localize=true}}</div>
      <div>{{system.agilityBonus}}</div>

      <div class="label-brown">Int</div>
      <div>{{formInput systemFields.intelligence value=system.intelligence localize=true}}</div>
      <div>{{system.intelligenceBonus}}</div>

      <div class="label-brown">Res</div>
      <div>{{formInput systemFields.resilience value=system.resilience localize=true}}</div>
      <div>{{system.resilienceBonus}}</div>

      <div class="label-brown">Soc</div>
      <div>{{formInput systemFields.social value=system.social localize=true}}</div>
      <div>{{system.socialBonus}}</div>
    </div>
  </div>
</header>
