{{! Stats tab}}
<section class="tab scrollable {{tab.cssClass}}" data-group:"primary" data-tab:"stats">
  <div class="flexrow">
    <div class="stats grid grid-5row grid-flow-horizontal grid-align-center">
      <!-- labels -->
      <div> </div>
      <div class="label-black">{{localize 'SOUL.Stats.base'}}</div>
      <div class="label-black">{{localize 'SOUL.Stats.modifiers'}}</div>
      <div class="label-black">{{localize 'SOUL.Stats.advancements'}}</div>
      <div class="label-black">{{localize 'SOUL.Stats.total'}}</div>

      <!-- stats auto -->
      {{#each stats as |stat name|}}
      <div class="label-brown">{{localize stat.shorthand}}</div>
      <div class="soul-tile">{{formInput stat.field value=stat.base}}</div>
      <div class="soul-tile">{{stat.modifier}}</div>
      <div class="soul-tile">{{stat.advances}}</div>
      <div class="soul-tile">{{stat.value}}</div>
      {{/each}}
    </div>
  </div>
</section>