{{! Skills tab}}
<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="skills">
  <div class="flexrow">
    <div class="skills grid grid-8col grid-align-center">
      <!-- labels -->
      <div class="label-brown grid-span-r3">{{localize 'SOUL.Skills.name'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.stat'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.level'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.maxLevel'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.modifier'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.total'}}</div>

      <!-- stats auto -->
      {{#each skills as |skill name|}}
      <div class="label-black grid-span-r3">{{localize skill.label}}</div>
      <div class="soul-tile">{{localize skill.statLabel}}</div>
      <div class="soul-tile">{{skill.system.level}}</div>
      <div class="soul-tile">{{skill.system.maxLevel}}</div>
      <div>{{formInput skill.fields.modifier value=skill.system.modifier}}</div>
      <div class="soul-tile">{{skill.system.value}}</div>
      {{/each}}
    </div>
  </div>
</section>