{{! Skills tab}}
<section class="tab scrollable {{tab.cssClass}} skills" data-group="primary" data-tab="skills">
  <div class="flexcol">
    {{#each skillTypes as |skillType|}}
    <div class="">{{localize skillType.label}}</div>
    <div class="grid grid-9col grid-align-center">
      <!-- labels -->
      <div class="label-brown grid-span-c4">{{localize 'SOUL.Skills.name'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.stat'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.level'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.maxLevel'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.modifier'}}</div>
      <div class="label-brown">{{localize 'SOUL.Skills.total'}}</div>

      <!-- stats auto -->
      {{#each skillType.values as |skill skillName|}}
      <div class="grid-span-c4">{{localize skill.label}}</div>
      <div class="">({{localize skill.statLabel}})</div>
      <div class="soul-tile">{{skill.system.level}}</div>
      <div class="soul-tile">{{skill.system.maxLevel}}</div>
      <div class="soul-tile">{{skill.system.modifier}}</div>
      <div class="soul-tile">{{skill.system.value}}</div>
      {{/each}}
    </div>
    {{/each}}
  </div>
</section>